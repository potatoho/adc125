extern volatile int TcpSlowTmrFlag;


/* ============================================================
 * 네트워크 처리
 *
 * DMA 대기 중과 UDP 전송 중 모두 반복 호출
 * ============================================================ */

static void service_network(void)
{
    if (TcpFastTmrFlag)
    {
        tcp_fasttmr();
        TcpFastTmrFlag = 0;
    }

    if (TcpSlowTmrFlag)
    {
        tcp_slowtmr();
        TcpSlowTmrFlag = 0;
    }

    xemacif_input(echo_netif);
}


